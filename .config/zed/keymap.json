[
  // ------------------------------------------------------
  // 1. MODO INSERTAR (Salida rápida)
  // ------------------------------------------------------
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      "j j": "vim::NormalBefore",
    },
  },

  // ------------------------------------------------------
  // 2. MODO NORMAL (LSP y Atajos principales)
  // ------------------------------------------------------
  {
    "context": "Editor && vim_mode == normal",
    "bindings": {
      "space e": "editor::Hover",

      // [d y ]d : Navegar entre errores
      "[ d": "editor::GoToDiagnostic",
      "] d": "editor::GoToPreviousDiagnostic",

      // <leader>el : Abrir panel inferior con lista de errores (setloclist)
      "space e l": "diagnostics::Deploy",

      // gd y K (Ya son nativos, pero si quisieras forzarlos sería así):
      // "g d": "editor::GoToDefinition",
      // "shift-k": "editor::Hover",

      // --- GESTIÓN DE ARCHIVOS Y PANELES (Lo que ya tenías) ---
      "space w": "workspace::Save",
      "space q": "pane::CloseActiveItem",
      "space q q": "pane::CloseActiveItem",

      // --- NAVEGACIÓN BUFFERS ---
      "tab": "pane::ActivateNextItem",
      "shift-tab": "pane::ActivatePreviousItem",
      "space t": "workspace::NewCenterTerminal",

      // --- SPLITS ---
      "space v s": "pane::SplitRight",
      "space l s": "pane::SplitDown",

      // --- BUSCADOR Y PANELES ---
      "space f": "file_finder::Toggle",
      "space a": "pane::DeploySearch",
      "space b": "tab_switcher::Toggle",
      "space p": "project_panel::ToggleFocus", // File explorer
      //"space p": "project_panel::ToggleFocus",

      // --- GIT ---
      "space c o": "git::Blame",
      "space h p": "editor::ToggleSelectedDiffHunks",
      "space h s": "editor::ToggleSelectedDiffHunks",
    },
  },

  // ------------------------------------------------------
  // 3. MODO VISUAL
  // ------------------------------------------------------
  {
    "context": "Editor && vim_mode == visual",
    "bindings": {
      "<": "editor::Outdent",
      ">": "editor::Indent",
    },
  },

  // ------------------------------------------------------
  // 4. MODO TERMINAL
  // ------------------------------------------------------
  {
    "context": "Terminal",
    "bindings": {
      "escape": "workspace::ActivatePaneLeft",
      "ctrl-t": "workspace::ToggleBottomDock",
    },
  },

  // ------------------------------------------------------
  // 5. NAVEGACIÓN PANELES
  // ------------------------------------------------------
  {
    "context": "Dock || Terminal || Editor",
    "bindings": {
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-j": "workspace::ActivatePaneDown",
    },
  },
  {
    "context": "Editor && vim_mode == insert && showing_completions",
    "bindings": {
      "ctrl-k": "editor::ContextMenuPrevious",
      "ctrl-j": "editor::ContextMenuNext",

      // Confirmar selección
      "tab": "editor::ConfirmCompletion",
      "enter": "editor::ConfirmCompletion",
    },
  },
]
